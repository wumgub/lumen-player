{
  "name": "lumen-player",
  "productName": "Lumen",
  "version": "0.2.1",
  "description": "An Electron MP3 player with reactive audio visualizers",
  "main": "./out/main/index.js",
  "author": {
    "name": "wumgub",
    "email": "67914953+wumgub@users.noreply.github.com"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "pack:mac": "electron-vite build && electron-builder --mac --publish never",
    "pack:win": "electron-vite build && electron-builder --win --publish never",
    "pack:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "better-sqlite3": "^11.8.1",
    "music-metadata": "^10.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
